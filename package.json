{
  "name": "fireflies-tech-challenge-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 8080",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "test": "bun test",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun run test",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "1.4.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "husky": "^9.1.7",
    "oxfmt": "^0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2"
  }
}
