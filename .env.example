# Copy to .env.local. Next.js loads it automatically.
# Same Clerk app as the backend. Next.js talks to Hono. The browser does not.
# OpenAI and AssemblyAI stay in the backend. Do not put them here.
# Parent `docker compose up` can inject these from the parent .env instead.

API_URL=http://localhost:3000

# Browser: ClerkProvider and the sign-in UI.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Next.js server: session, auth.protect, getToken.
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
